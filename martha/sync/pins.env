# What the fork's sync job and its trial run are pinned to (macula-io/martha#547 S2). One KEY=VALUE per line:
# the scripts source this file and the workflows append it to $GITHUB_ENV, so each value is written here only.
# Moving any of them is a reviewed change to this file.

# The project the fork follows, and the release tags it syncs.
UPSTREAM_URL=https://github.com/aaif-goose/goose.git
UPSTREAM_TAG_PATTERN=^v[0-9]+[.][0-9]+[.][0-9]+$

# Martha, whose trial driver (trial_the_goose_host/) runs the #541 trial lines against the engine.
MARTHA_REPOSITORY=macula-io/martha
MARTHA_SHA=39a5fc07d68df98cf5b3bdd148bcd23b8424f4cc

# The only workflows that may be active on the fork: its own two, and upstream's read-only CI, which the sync runs.
# Every other workflow upstream ships publishes, writes or moves main, and stays off (martha-engine-checks.yml fails
# while one is active).
FORK_WORKFLOWS="martha-engine-sync.yml martha-engine-checks.yml ci.yml"

# The local model the trial lines run on: the build and the model the #541 trial record names.
OLLAMA_VERSION=0.20.4
OLLAMA_ASSET=ollama-linux-amd64.tar.zst
OLLAMA_SHA256=5a6894c78cf801ef842949ff5cf986024df5e12ae0715f6c4cf49b1f28dbe052
TRIAL_MODEL=ministral-3:3b
TRIAL_MODEL_DIGEST=f04aa1c738f64e13c625b82ae92504fc0260fa6723b509ed1ece0fa188179b1d

# The owner's limits on a trial launch: ten minutes each; the nine lines launch once each, inside the two a check may use.
TRIAL_LINES=1,2,3,4,5,6,7,8,9
TRIAL_MINUTES_PER_LAUNCH=10
